<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0B0B" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXTRACTOR WEB" android:textColor="#FF6600" android:textSize="28sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Autómata e intérprete de datos" android:textColor="#CCCCCC" android:gravity="center" android:layout_marginBottom="20dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DIRECCIÓN DE LA PÁGINA WEB" android:textColor="#FF6600" android:textStyle="bold" android:layout_marginBottom="8dp" />
    <EditText android:id="@+id/entradaUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#202020" android:hint="https://example.com" android:inputType="textUri" android:singleLine="true" android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#999999" />
    <Button android:id="@+id/btnDescargar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DESCARGAR PÁGINA WEB" android:layout_marginTop="8dp" android:backgroundTint="#FF6600" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/estadoDescarga" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Introduce una URL para comenzar." android:textColor="#CCCCCC" android:paddingTop="8dp" android:paddingBottom="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÓDIGO HTML" android:textColor="#FF6600" android:textStyle="bold" android:layout_marginBottom="8dp" />
    <EditText android:id="@+id/entradaTexto" android:layout_width="match_parent" android:layout_height="190dp" android:background="#202020" android:gravity="top|start" android:hint="Aquí aparecerá el HTML descargado. También puedes escribirlo manualmente." android:inputType="textMultiLine|textNoSuggestions" android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#999999" android:fontFamily="monospace" />
    <Button android:id="@+id/btnEjemplo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargar ejemplo" android:layout_marginTop="10dp" />
    <Button android:id="@+id/btnAnalizar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANALIZAR TEXTO" android:backgroundTint="#FF6600" android:textColor="#FFFFFF" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RESULTADOS DEL ANÁLISIS" android:textColor="#FF6600" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="20dp" android:layout_marginBottom="10dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VISTA PREVIA DE IMÁGENES" android:textColor="#FF6600" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="20dp" />
    <LinearLayout android:id="@+id/galeriaImagenes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />    <TextView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANALIZADOR MATEMÁTICO" android:textColor="#FF6600" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" />

    <TextView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escribe instrucciones matemáticas para analizar variables y operaciones." android:textColor="#CCCCCC" android:layout_marginBottom="10dp" />

    <EditText xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/entradaCodigoMatematico" android:layout_width="match_parent" android:layout_height="180dp" android:background="#202020" android:gravity="top|start" android:hint="Escribe aquí tu código matemático" android:inputType="textMultiLine|textNoSuggestions" android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#999999" android:fontFamily="monospace" />

    <Button xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/btnAnalizarMatematico" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANALIZAR CÓDIGO MATEMÁTICO" android:layout_marginTop="10dp" android:backgroundTint="#FF6600" android:textColor="#FFFFFF" />

    <TextView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/resultadoMatematico" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1B1B1B" android:padding="14dp" android:layout_marginTop="10dp" android:text="El resultado matemático aparecerá aquí." android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="monospace" /><TextView android:id="@+id/resultadoTexto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1B1B1B" android:padding="14dp" android:text="Los resultados aparecerán aquí." android:textColor="#FFFFFF" android:textSize="14sp" /></LinearLayout>
</ScrollView>